# === Параметры базы данных (PostgreSQL) ===
AUTO_SHOP_DATABASE_USERNAME=auto_shop
AUTO_SHOP_DATABASE_PASSWORD=changeme
AUTO_SHOP_DATABASE_NAME=auto_shop_production

# === Backend (Rails) ===
# Обязательно для production. Сгенерируйте, например:
#   openssl rand -hex 64
SECRET_KEY_BASE=

# Origin(ы) фронтенда для CORS (через пробел). Для деплоя укажите домен,
# например: https://shop.example.com
FRONTEND_ORIGINS=http://localhost

# Порт, на котором backend доступен на хосте
BACKEND_PORT=3000

# Логи и пул потоков (необязательно)
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5

# === Frontend (React/Vite) ===
# Публичный адрес backend API — вшивается в сборку фронтенда.
# Локально: http://localhost:3000
# На сервере: например, https://api.example.com
VITE_API_URL=http://localhost:3000

# Порт, на котором фронтенд доступен на хосте
FRONTEND_PORT=80
